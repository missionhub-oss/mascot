  "animations": {
    "idle": {
      "frames": ["idle", "idle_blink", "idle", "idle_blink"],
      "frame_durations_ms": [1800, 140, 1400, 130],
      "loop": true,
      "gif": "animations/idle.gif"
    },
    "walk": {
      "frames": ["walk1", "walk_pass1", "walk2", "walk_pass2"],
      "frame_durations_ms": [135, 135, 135, 135],
      "loop": true,
      "gif": "animations/walk.gif"
    },
    "happy": {
      "frames": ["happy", "idle_wave"],
      "frame_durations_ms": [240, 240],
      "loop": true,
      "gif": "animations/happy.gif"
    },
    "strike": {
      "frames": ["idle", "swing_windup", "swing", "swing_follow"],
      "frame_durations_ms": [320, 150, 140, 420],
      "loop": false,
      "gif": "animations/strike.gif"
    },
    "jump": {
      "frames": ["crouch", "jump", "fall", "crouch", "happy"],
      "frame_durations_ms": [110, 220, 220, 120, 340],
      "loop": false,
      "gif": "animations/jump.gif"
    },
    "dangling": {
      "frames": ["dangling", "dangling2"],
      "frame_durations_ms": [180, 180],
      "loop": true,
      "gif": "animations/dangling.gif"
    },
    "sleep": {
      "frames": ["sleep", "sleep2"],
      "frame_durations_ms": [1100, 1100],
      "loop": true,
      "gif": "animations/sleep.gif"
    }
  },
  "agent_states": {
    "idle": {
      "animation": "idle",
      "description": "Agent is idle; pet stands, blinks naturally, and strolls occasionally"
    },
    "thinking": {
      "frames": ["curious", "idle_blink"],
      "description": "Agent is reasoning or planning; pet tilts head curiously"
    },
    "working": {
      "animation": "walk",
      "description": "Agent is actively executing tasks; pet patrols briskly along the floor"
    },
    "tool_call": {
      "animation": "strike",
      "description": "Agent invokes a tool or command; pet performs a 3-phase kendo shinai strike"
    },
    "success": {
      "animation": "happy",
      "description": "Task completed cleanly; pet leaps and cheers with sparkles"
    },
    "error": {
      "frames": ["dangling", "swing"],
      "description": "Tool or run failed; pet does a startled hop into a determined kendo stance"
    },
    "waiting": {
      "frames": ["idle_wave", "idle"],
      "description": "Waiting for user input or approval; pet waves warmly to catch attention"
    },
    "sleeping": {
      "animation": "sleep",
      "description": "Session inactive or paused; pet sits peacefully in seiza and naps"
    }
  },
  "runtime": {
    "web_esm": "runtime/missionhub-pet.mjs",
    "preview": "runtime/preview.html"
  }
}
